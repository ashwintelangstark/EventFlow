<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Serve existing files and directories directly (landing page, assets, videos, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Single Page Application routing fallback
  RewriteRule ^ index.html [L]
</IfModule>

# GZIP / Deflate Compression for high speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg .svgz
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/webp .webp
  AddType image/png .png
  AddType image/jpeg .jpg .jpeg
</IfModule>

# Browser Caching & Cache-Control
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 day"

  # Images and Icons
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"

  # Media
  ExpiresByType video/mp4 "access plus 1 month"

  # Styles & Scripts
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML - revalidate for fresh updates
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Cache Vite hashed assets aggressively
  <FilesMatch "\.(js|css|woff2?|png|jpe?g|svg|mp4)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>

  # Do not cache index.html so releases update immediately
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
