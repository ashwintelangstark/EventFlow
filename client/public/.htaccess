<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Proxy /api requests to local Node.js backend port 5001 (if mod_proxy is active)
  <IfModule mod_proxy.c>
    RewriteRule ^api/(.*)$ http://127.0.0.1:5001/api/$1 [P,L]
  </IfModule>

  # 3. Serve existing files and directories directly (landing page, assets, videos, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Single Page Application routing fallback
  RewriteRule ^ index.html [L]
</IfModule>

# MIME Types
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType image/svg+xml .svg .svgz
  AddType application/javascript .js .mjs
  AddType text/css .css
  AddType application/json .json
  AddType image/webp .webp
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>
